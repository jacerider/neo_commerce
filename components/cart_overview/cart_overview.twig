{#
  Cart | Overview — every cart a shopper holds.

  Rendered at /cart when a shopper holds more than one cart (one cart goes
  straight to its own page), and as the empty state when nothing is in any
  cart. Each card links to that cart's page with "View cart".

  `cart.notice` is already filtered and may hold strong, em and links; it
  prints as is.

  Own this file: it is copied into your theme on install and yours to restyle
  from there. Run `drush cr` after editing.
#}
{% set tag = title_tag ?: 'h1' %}
<div{{ attributes.addClass(['cart-overview', compact ? 'cart-overview--compact']) }}>
  {% if empty %}
    <div class="cart-overview__empty py-14 text-center">
      {% if empty_title %}
        <{{ tag }} class="mb-2 text-3xl">{{ empty_title }}</{{ tag }}>
      {% endif %}
      {% if empty_text %}
        <p class="mb-6 italic opacity-70">{{ empty_text }}</p>
      {% endif %}
      {% if empty_cta_label and empty_cta_url %}
        <a href="{{ empty_cta_url }}" class="btn">{{ empty_cta_label }}</a>
      {% endif %}
    </div>
  {% else %}
    {% if not compact and (kicker or title or intro) %}
      <header class="cart-overview__head mb-8 text-center">
        {% if kicker %}
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">{{ kicker }}</p>
        {% endif %}
        {% if title %}
          <{{ tag }} class="text-4xl">{{ title }}</{{ tag }}>
        {% endif %}
        {% if intro %}
          <p class="mt-2 italic opacity-70">{{ intro }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="cart-overview__carts flex flex-col gap-6">
      {% for cart in carts %}
        <section class="cart-overview__cart border">
          <div class="flex items-start justify-between gap-3 border-b p-4 sm:p-6">
            <div>
              <h2 class="text-2xl">{{ cart.title }}</h2>
              <span class="mt-1 block text-xs font-semibold uppercase tracking-widest text-accent">{{ cart.count_text }}</span>
            </div>
            <div class="text-right">
              <span class="block text-xs font-semibold uppercase tracking-widest opacity-60">{{ 'Subtotal'|t }}</span>
              <span class="text-2xl">{{ cart.subtotal }}</span>
            </div>
          </div>
          {% if cart.notice %}
            <div class="mx-4 mt-4 flex items-start gap-2 border p-3 sm:mx-6">
              {% if cart.notice_icon %}
                <span class="mt-1 shrink-0">{{ icon(cart.notice_icon)|icon_only }}</span>
              {% endif %}
              <div>{{ cart.notice }}</div>
            </div>
          {% endif %}
          <div class="flex flex-col gap-6 p-4 sm:flex-row sm:items-center sm:p-6">
            <ul class="flex flex-1 flex-wrap gap-3">
              {% for thumb in cart.thumbnails %}
                <li class="relative size-19 border" title="{{ thumb.title }}">
                  {% if thumb.src %}
                    {{ neo_image_style(thumb.src, {focal: {width: 152, height: 152}}, thumb.alt, '', {class: ['size-full', 'object-cover']}) }}
                  {% else %}
                    <span class="sr-only">{{ thumb.title }}</span>
                  {% endif %}
                  {% if thumb.quantity > 1 %}
                    <span class="absolute -right-2 -top-2 flex h-5.5 min-w-5.5 items-center justify-center rounded-full px-1 text-xs">{{ thumb.quantity }}</span>
                  {% endif %}
                </li>
              {% endfor %}
              {% if cart.more %}
                <li class="flex size-19 items-center justify-center border text-sm">+{{ cart.more }}</li>
              {% endif %}
            </ul>
            <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
              {% if cart.continue_label and cart.continue_url %}
                <a href="{{ cart.continue_url }}" class="btn btn-outline">{{ cart.continue_label }}</a>
              {% endif %}
              <a href="{{ cart.view_url }}" class="btn">{{ cart.view_label }}</a>
            </div>
          </div>
        </section>
      {% endfor %}
    </div>

    {% if explainer and not compact %}
      <div class="cart-overview__explainer mx-auto mt-10 max-w-xl text-center opacity-80">{{ explainer }}</div>
    {% endif %}
  {% endif %}
</div>
