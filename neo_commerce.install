<?php

/**
 * @file
 * Install and update hooks for neo_commerce.
 */

/**
 * Removes the product_card_image_style setting.
 *
 * The card component now receives its image as data and crops it with
 * neo_image in its own template, so a core image style no longer applies.
 */
function neo_commerce_update_10001(): string {
  $configFactory = \Drupal::configFactory();
  $cleared = [];

  $names = ['neo_commerce.settings'];
  foreach ($configFactory->listAll('neo_settings.variation.') as $name) {
    if ($configFactory->get($name)->get('plugin') === 'neo_commerce') {
      $names[] = $name;
    }
  }

  foreach ($names as $name) {
    $config = $configFactory->getEditable($name);
    // Variations nest their values under `settings`; the base config does not.
    $prefix = str_starts_with($name, 'neo_settings.variation.') ? 'settings.' : '';
    if ($config->get($prefix . 'product_card_image_style') === NULL) {
      continue;
    }
    $config->clear($prefix . 'product_card_image_style')->save();
    $cleared[] = $name;
  }

  return $cleared
    ? sprintf('Removed product_card_image_style from: %s.', implode(', ', $cleared))
    : 'No product_card_image_style setting to remove.';
}

/**
 * Adds the cart page settings.
 *
 * Only the base config needs them: variations store just the keys they
 * override and read everything else through the base.
 */
function neo_commerce_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('neo_commerce.settings');
  $defaults = [
    'cart_page_component' => 'neo_commerce:cart_page',
    'cart_overview_component' => 'neo_commerce:cart_overview',
    'cart_line_component' => 'neo_commerce:cart_line',
    'cart_quantity_instant' => TRUE,
    'cart_overview_thumbnail_limit' => 8,
    'cart_explainer' => '',
    'cart_copy' => [
      'kicker' => '',
      'title' => 'Your cart',
      'intro' => '',
      'notice' => '',
      'notice_icon' => '',
      'footnote' => 'Taxes and delivery are calculated at checkout.',
      'checkout_label' => '',
      'continue_label' => 'Continue shopping',
      'continue_url' => '',
      'empty_title' => 'Your cart is empty',
      'empty_text' => '',
      'empty_cta_label' => 'Continue shopping',
      'empty_cta_url' => '',
    ],
    'cart_copy_types' => [],
    'cart_overview' => [
      'kicker' => '',
      'title' => 'Your cart',
      'intro' => '',
      'empty_title' => 'Your cart is empty',
      'empty_text' => '',
      'empty_cta_label' => 'Continue shopping',
      'empty_cta_url' => '',
    ],
  ];

  $added = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $added[] = $key;
    }
  }
  if ($added) {
    $config->save();
  }

  return $added
    ? sprintf('Added cart page settings: %s.', implode(', ', $added))
    : 'Cart page settings already present.';
}
