<?php

/**
 * @file
 * Install and update hooks for neo_commerce.
 */

use Drupal\neo_commerce\Hook\InstallHooks;

/**
 * Removes the product_card_image_style setting.
 *
 * The card component now receives its image as data and crops it with
 * neo_image in its own template, so a core image style no longer applies.
 */
function neo_commerce_update_10001(): string {
  $configFactory = \Drupal::configFactory();
  $cleared = [];

  $names = ['neo_commerce.settings'];
  foreach ($configFactory->listAll('neo_settings.variation.') as $name) {
    if ($configFactory->get($name)->get('plugin') === 'neo_commerce') {
      $names[] = $name;
    }
  }

  foreach ($names as $name) {
    $config = $configFactory->getEditable($name);
    // Variations nest their values under `settings`; the base config does not.
    $prefix = str_starts_with($name, 'neo_settings.variation.') ? 'settings.' : '';
    if ($config->get($prefix . 'product_card_image_style') === NULL) {
      continue;
    }
    $config->clear($prefix . 'product_card_image_style')->save();
    $cleared[] = $name;
  }

  return $cleared
    ? sprintf('Removed product_card_image_style from: %s.', implode(', ', $cleared))
    : 'No product_card_image_style setting to remove.';
}

/**
 * Adds the cart page settings.
 *
 * Only the base config needs them: variations store just the keys they
 * override and read everything else through the base.
 */
function neo_commerce_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('neo_commerce.settings');
  $defaults = [
    'cart_page_component' => 'neo_commerce:cart_page',
    'cart_overview_component' => 'neo_commerce:cart_overview',
    'cart_line_component' => 'neo_commerce:cart_line',
    'cart_quantity_instant' => TRUE,
    'cart_overview_thumbnail_limit' => 8,
    'cart_explainer' => '',
    'cart_copy' => [
      'kicker' => '',
      'title' => 'Your cart',
      'intro' => '',
      'notice' => '',
      'notice_icon' => '',
      'footnote' => 'Taxes and delivery are calculated at checkout.',
      'checkout_label' => '',
      'continue_label' => 'Continue shopping',
      'continue_url' => '',
      'empty_title' => 'Your cart is empty',
      'empty_text' => '',
      'empty_cta_label' => 'Continue shopping',
      'empty_cta_url' => '',
    ],
    'cart_copy_types' => [],
    'cart_overview' => [
      'kicker' => '',
      'title' => 'Your cart',
      'intro' => '',
      'empty_title' => 'Your cart is empty',
      'empty_text' => '',
      'empty_cta_label' => 'Continue shopping',
      'empty_cta_url' => '',
      'view_label' => 'View cart',
      'back_label' => 'Back to your cart',
    ],
  ];

  $added = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $added[] = $key;
    }
  }
  if ($added) {
    $config->save();
  }

  return $added
    ? sprintf('Added cart page settings: %s.', implode(', ', $added))
    : 'Cart page settings already present.';
}

/**
 * Copies the cart page components into the theme and points the cart at them.
 *
 * The cart page, cart line and cart overview components replace the cart
 * form's table. Like the cart summary, the theme owns its copies: this puts
 * them in the front theme and names them in the settings, unless a site has
 * already chosen components of its own. Strip `neo_install: true` from the
 * copies afterwards, as for cart_quick.
 */
function neo_commerce_update_10003(): string {
  $config = \Drupal::configFactory()->getEditable('neo_commerce.settings');
  // A key the config never stored would read as a site's own choice and be
  // kept, so start it at the shipped default.
  foreach (InstallHooks::CART_PAGE_COMPONENTS as $key => $default) {
    if ($config->get($key) === NULL) {
      $config->set($key, $default);
    }
  }
  $config->save();

  $results = \Drupal::service(InstallHooks::class)->claimCartPageComponents();
  $report = [];
  foreach ($results as $key => $result) {
    $report[] = $key . ': ' . $result;
  }
  return 'Cart page components ' . implode(', ', $report) . '.';
}

/**
 * Adds the simple page layout settings, both off.
 */
function neo_commerce_update_10004(): string {
  $config = \Drupal::configFactory()->getEditable('neo_commerce.settings');
  foreach (['simple_layout_cart', 'simple_layout_checkout'] as $key) {
    if ($config->get($key) === NULL) {
      $config->set($key, FALSE);
    }
  }
  $config->save();
  return 'Added the simple page layout settings, off.';
}

/**
 * Adds the single-page checkout settings and copies its component.
 *
 * The checkout_page component lays out the neo_single_page checkout flow.
 * The theme owns its copy, as with the cart page components: this puts it in
 * the front theme and names it in the settings. Strip `neo_install: true`
 * from the copy afterwards.
 */
function neo_commerce_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('neo_commerce.settings');
  $defaults = [
    'checkout_page_component' => 'neo_commerce:checkout_page',
    'checkout_copy' => [
      'kicker' => '',
      'title' => 'Checkout',
      'intro' => '',
      'summary_title' => 'Order Summary',
      'summary_toggle_label' => 'Show order summary',
      'place_order_label' => 'Place order',
      'secure_note' => 'Encrypted & secure',
    ],
    'checkout_copy_types' => [],
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();

  $results = \Drupal::service(InstallHooks::class)->claimCartPageComponents();
  return 'Checkout page component: '
    . ($results['checkout_page_component'] ?? 'unavailable') . '.';
}
