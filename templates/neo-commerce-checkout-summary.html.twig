{#
/**
 * @file
 * The order summary on the single-page checkout.
 *
 * Replaces the order summary pane's view on that page, so it is redrawn with
 * the pane whenever the order changes (shipping, a coupon, a gift card).
 *
 * Available variables:
 * - items: One per order line: title, meta (the tagline field, may be
 *   empty), total (formatted), count (quantity), image (src, alt, width,
 *   height from the product image field; empty when there is none). The
 *   image arrives as data and is cropped here with neo_image, so the crop
 *   matches the box: change both together.
 * - totals: Commerce's order total summary (subtotal, adjustments, total).
 *
 * Override in the theme to restyle.
 */
#}
<div class="neo-checkout-summary">
  <ul class="neo-checkout-summary__items">
    {% for item in items %}
      <li class="neo-checkout-summary__item">
        <span class="neo-checkout-summary__image">
          {% if item.image.src %}
            {{ neo_image_style(item.image.src, {focal: {width: 120, height: 120}}, item.image.alt, '', {class: ['neo-checkout-summary__img']}) }}
          {% endif %}
          <span class="neo-checkout-summary__count">
            <span class="visually-hidden">{{ 'Quantity'|t }}</span>
            {{ item.count }}
          </span>
        </span>
        <span class="neo-checkout-summary__body">
          <span class="neo-checkout-summary__line">
            <span class="neo-checkout-summary__title">{{ item.title }}</span>
            <span class="neo-checkout-summary__total">{{ item.total }}</span>
          </span>
          {% if item.meta %}
            <span class="neo-checkout-summary__meta">{{ item.meta }}</span>
          {% endif %}
        </span>
      </li>
    {% endfor %}
  </ul>
  {% if totals %}
    <div class="neo-checkout-summary__totals">{{ totals }}</div>
  {% endif %}
</div>
